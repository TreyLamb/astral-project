  "PEWTER_GYM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_BROCK",
      "before": [
        "I'm BROCK!\nI'm PEWTER's GYM\nLEADER!",
        "I believe in rock\nhard defense and\ndetermination!",
        "That's why my\nPOKéMON are all\nthe rock-type!",
        "Do you still want\nto challenge me?\nFine then! Show\nme your best!"
      ],
      "win": [
        "I took\nyou for granted.",
        "As proof of your\nvictory, here's\nthe BOULDERBADGE!",
        "<PLAYER> received\nthe BOULDERBADGE!",
        "That's an official\nPOKéMON LEAGUE\nBADGE!",
        "Its bearer's\nPOKéMON become\nmore powerful!",
        "The technique\nFLASH can now be\nused any time!"
      ],
      "after": []
    },
    {
      "objectIndex": 2,
      "eventFlag": "EVENT_BEAT_PEWTER_GYM_TRAINER_0",
      "before": [
        "Stop right there,\nkid!",
        "You're still light\nyears from facing\nBROCK!"
      ],
      "win": [
        "Darn!",
        "Light years isn't\ntime! It measures\ndistance!"
