  "CERULEAN_GYM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_MISTY",
      "before": [
        "Hi, you're a new\nface!",
        "Trainers who want\nto turn pro have\nto have a policy\nabout POKéMON!",
        "What is your\napproach when you\ncatch POKéMON?",
        "My policy is an\nall-out offensive\nwith water-type\nPOKéMON!"
      ],
      "win": [
        "Wow!\nYou're too much!",
        "All right!",
        "You can have the\nCASCADEBADGE to\nshow you beat me!"
      ],
      "after": []
    },
    {
      "objectIndex": 2,
      "eventFlag": "EVENT_BEAT_CERULEAN_GYM_TRAINER_0",
      "before": [
        "I'm more than good\nenough for you!",
        "MISTY can wait!"
      ],
      "win": [
        "You\noverwhelmed me!"
      ],
      "after": [
        "You have to face\nother trainers to\nfind out how good\nyou really are."
      ]
    },
    {
      "objectIndex": 3,
      "eventFlag": "EVENT_BEAT_CERULEAN_GYM_TRAINER_1",
      "before": [
        "Splash!",
        "I'm first up!\nLet's do it!"
      ],
      "win": [
        "That\ncan't be!"
      ],
      "after": [
        "MISTY is going to\nkeep improving!",
        "She won't lose to\nsomeone like you!"
      ]
    }
  ],
  "CINNABAR_GYM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_BLAINE",
      "before": [
        "Hah!",
        "I am BLAINE! I\nam the LEADER of\nCINNABAR GYM!",
