    },
    {
      "objectIndex": 6,
      "eventFlag": "EVENT_BEAT_FUCHSIA_GYM_TRAINER_4",
      "before": [
        "I also study the\nway of the ninja\nwith master KOGA!",
        "Ninja have a long\nhistory of using\nanimals!"
      ],
      "win": [
        "Awoo!"
      ],
      "after": [
        "I still have much\nto learn!"
      ]
    },
    {
      "objectIndex": 7,
      "eventFlag": "EVENT_BEAT_FUCHSIA_GYM_TRAINER_5",
      "before": [
        "Master KOGA comes\nfrom a long line\nof ninjas!",
        "What did you\ndescend from?"
      ],
      "win": [
        "Dropped\nmy balls!"
      ],
      "after": [
        "Where there is\nlight, there is\nshadow!",
        "Light and shadow!\nWhich do you\nchoose?"
      ]
    }
  ],
  "LANCES_ROOM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_LANCES_ROOM_TRAINER_0",
      "before": [
        "Ah! I heard about\nyou <PLAYER>!",
        "I lead the ELITE\nFOUR! You can\ncall me LANCE the\ndragon trainer!",
        "You know that\ndragons are\nmythical POKéMON!",
        "They're hard to\ncatch and raise,\nbut their powers\nare superior!",
        "They're virtually\nindestructible!",
        "Well, are you\nready to lose?",
        "Your LEAGUE\nchallenge ends\nwith me, <PLAYER>!"
      ],
      "win": [
        "That's it!",
        "I hate to admit\nit, but you are a\nPOKéMON master!"
      ],
      "after": [
        "I still can't\nbelieve my\ndragons lost to\nyou, <PLAYER>!",
        "You are now the\nPOKéMON LEAGUE\nchampion!",
        "...Or, you would\nhave been, but\nyou have one more\nchallenge ahead.",
        "You have to face\nanother trainer!\nHis name is...",
        "<RIVAL>!\nHe beat the ELITE\nFOUR before you!",
        "He is the real\nPOKéMON LEAGUE\nchampion!"
      ]
    }
  ],
