    {
      "objectIndex": 6,
      "eventFlag": "EVENT_BEAT_CINNABAR_GYM_TRAINER_4",
      "before": [
        "I know why BLAINE\nbecame a trainer!"
      ],
      "win": [
        "Ow!"
      ],
      "after": [
        "BLAINE was lost\nin the mountains\nwhen a fiery bird\nPOKéMON appeared.",
        "Its light enabled\nBLAINE to find\nhis way down!"
