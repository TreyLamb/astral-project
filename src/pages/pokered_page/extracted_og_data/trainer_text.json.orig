  "FUCHSIA_GYM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_KOGA",
      "before": [
        "KOGA: Fwahahaha!",
        "A mere child like\nyou dares to\nchallenge me?",
        "Very well, I\nshall show you\ntrue terror as a\nninja master!",
        "You shall feel\nthe despair of\npoison and sleep\ntechniques!"
