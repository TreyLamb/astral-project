{
  "AGATHAS_ROOM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_AGATHAS_ROOM_TRAINER_0",
      "before": [
        "I am AGATHA of\nthe ELITE FOUR!",
        "OAK's taken a lot\nof interest in\nyou, child!",
        "That old duff was\nonce tough and\nhandsome! That\nwas decades ago!",
        "Now he just wants\nto fiddle with\nhis POKéDEX! He's\nwrong! POKéMON\nare for fighting!",
        "<PLAYER>! I'll show\nyou how a real\ntrainer fights!"
      ],
      "win": [
        "Oh ho!\nYou're something\nspecial, child!"
      ],
      "after": [
        "You win! I see\nwhat the old duff\nsees in you now!",
        "I have nothing\nelse to say! Run\nalong now, child!"
      ]
    }
  ],
  "BRUNOS_ROOM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_BRUNOS_ROOM_TRAINER_0",
      "before": [
        "I am BRUNO of\nthe ELITE FOUR!",
        "Through rigorous\ntraining, people\nand POKéMON can\nbecome stronger!",
        "I've weight\ntrained with\nmy POKéMON!",
        "<PLAYER>!",
        "We will grind you\ndown with our\nsuperior power!",
        "Hoo hah!"
      ],
      "win": [
        "Why?\nHow could I lose?"
      ],
      "after": [
        "My job is done!\nGo face your next\nchallenge!"
      ]
    }
  ],
  "CELADON_GYM": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_ERIKA",
      "before": [
        "Hello. Lovely\nweather isn't it?\nIt's so pleasant.",
        "...Oh dear...\nI must have dozed\noff. Welcome.",
        "My name is ERIKA.\nI am the LEADER\nof CELADON GYM.",
        "I teach the art of\nflower arranging.\nMy POKéMON are of\nthe grass-type.",
        "Oh, I'm sorry, I\nhad no idea that\nyou wished to\nchallenge me.",
        "Very well, but I\nshall not lose."
      ],
      "win": [
        "Oh!\nI concede defeat.",
        "You are remarkably\nstrong.",
        "I must confer you\nthe RAINBOWBADGE."
      ],
      "after": [
        "You are cataloging
#MON? I must
say I'm impressed.",
        "I would never
collect #MON
if they were
unattractive."
      ]
    },
    {
      "objectIndex": 2,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_0",
      "before": [
        "Hey!",
        "You are not\nallowed in here!"
      ],
      "win": [
        "You're\ntoo rough!"
      ],
      "after": [
        "Bleaah!\nI hope ERIKA\nwipes you out!"
      ]
    },
    {
      "objectIndex": 3,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_1",
      "before": [
        "I was getting\nbored."
      ],
      "win": [
        "My\nmakeup!"
      ],
      "after": [
        "Grass-type POKéMON\nare tough against\nthe water-type!",
        "They also have an\nedge on rock and\nground POKéMON!"
      ]
    },
    {
      "objectIndex": 4,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_2",
      "before": [
        "Aren't you the\npeeping Tom?"
      ],
      "win": [
        "I'm\nin shock!"
      ],
      "after": [
        "Oh, you weren't\npeeping? We get a\nlot of gawkers!"
      ]
    },
    {
      "objectIndex": 5,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_3",
      "before": [
        "Look at my grass\nPOKéMON!",
        "They're so easy\nto raise!"
      ],
      "win": [
        "No!"
      ],
      "after": [
        "We only use grass-\ntype POKéMON at\nour GYM!",
        "We also use them\nfor making flower\narrangements!"
      ]
    },
    {
      "objectIndex": 6,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_4",
      "before": [
        "Don't bring any\nbugs or fire\nPOKéMON in here!"
      ],
      "win": [
        "Oh!\nYou!"
      ],
      "after": [
        "Our LEADER, ERIKA,\nmight be quiet,\nbut she's also\nvery skilled!"
      ]
    },
    {
      "objectIndex": 7,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_5",
      "before": [
        "Pleased to meet\nyou. My hobby is\nPOKéMON training."
      ],
      "win": [
        "Oh!\nSplendid!"
      ],
      "after": [
        "I have a blind\ndate coming up.\nI have to learn\nto be polite."
      ]
    },
    {
      "objectIndex": 8,
      "eventFlag": "EVENT_BEAT_CELADON_GYM_TRAINER_6",
      "before": [
        "Welcome to\nCELADON GYM!",
        "You better not\nunderestimate\ngirl power!"
      ],
      "win": [
        "Oh!\nBeaten!"
      ],
      "after": [
        "I didn't bring my\nbest POKéMON!",
        "Wait 'til next\ntime!"
      ]
    }
  ],
