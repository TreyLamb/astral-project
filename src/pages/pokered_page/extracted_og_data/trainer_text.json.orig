    },
    {
      "objectIndex": 8,
      "eventFlag": "EVENT_BEAT_CINNABAR_GYM_TRAINER_6",
      "before": [
        "Fire is weak\nagainst H2O!"
      ],
      "win": [
        "Oh!\nSnuffed out!"
      ],
      "after": [
        "Water beats fire!\nBut, fire melts\nice POKéMON!"
      ]
    }
  ],
  "FIGHTING_DOJO": [
    {
      "objectIndex": 1,
      "eventFlag": "EVENT_BEAT_KARATE_MASTER",
      "before": [
