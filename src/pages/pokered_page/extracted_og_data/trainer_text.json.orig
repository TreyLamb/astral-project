    },
    {
      "objectIndex": 7,
      "eventFlag": "EVENT_BEAT_CINNABAR_GYM_TRAINER_5",
      "before": [
        "I've been to many\nGYMs, but this is\nmy favorite!"
      ],
      "win": [
        "Yowza!\nToo hot!"
      ],
      "after": [
        "Us fire POKéMON\nfans like PONYTA\nand NINETALES!"
